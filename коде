<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Midnight Seduction - Horror</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #050505;
            overflow: hidden;
            font-family: 'Courier New', Courier, monospace;
            user-select: none;
            cursor: crosshair;
        }

        canvas {
            display: block;
        }

        /* ЭКРАН СТАРТА */
        #start-screen {
            position: absolute;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.85);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #ff0033;
            z-index: 100;
            text-align: center;
            backdrop-filter: blur(5px);
        }

        h1 {
            font-size: 50px;
            text-shadow: 0 0 20px #ff0033, 0 0 40px #ff0033;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 5px;
        }

        p {
            color: #ddd;
            font-size: 18px;
            max-width: 600px;
            line-height: 1.5;
        }

        .btn {
            margin-top: 30px;
            padding: 15px 40px;
            font-size: 24px;
            font-weight: bold;
            color: #fff;
            background: transparent;
            border: 2px solid #ff0033;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.3s;
            box-shadow: 0 0 15px rgba(255, 0, 51, 0.5);
        }

        .btn:hover {
            background: #ff0033;
            box-shadow: 0 0 30px #ff0033;
        }

        /* UI */
        #ui {
            position: absolute;
            top: 20px;
            left: 20px;
            color: #fff;
            font-size: 24px;
            font-weight: bold;
            text-shadow: 0 0 10px #ff0033;
            pointer-events: none;
            z-index: 10;
        }

        /* КРОВАВЫЙ ОВЕРЛЕЙ */
        #blood-overlay {
            position: absolute;
            top: 0; left: 0; width: 100vw; height: 100vh;
            pointer-events: none;
            box-shadow: inset 0 0 100px 50px rgba(255, 0, 0, 0);
            transition: box-shadow 0.3s;
            z-index: 50;
        }

        /* СКРИМЕР */
        #jumpscare {
            position: absolute;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: #000;
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        #jumpscare-face {
            font-size: 50vh;
            text-shadow: 0 0 50px red;
            animation: shake 0.05s infinite;
        }

        @keyframes shake {
            0% { transform: translate(10px, 10px) scale(1.1) rotate(5deg); }
            25% { transform: translate(-10px, -10px) scale(1.2) rotate(-5deg); }
            50% { transform: translate(-10px, 10px) scale(1.1) rotate(5deg); }
            75% { transform: translate(10px, -10px) scale(1.3) rotate(-5deg); }
            100% { transform: translate(10px, 10px) scale(1.1) rotate(5deg); }
        }
    </style>
</head>
<body>

    <div id="ui">Артефакты: <span id="score">0</span> / 3</div>
    <div id="blood-overlay"></div>

    <div id="start-screen">
        <h1>Midnight Seduction</h1>
        <p>Собери 3 кровавых артефакта, чтобы выбраться.<br>Она охотится на тебя. Не попадись ей в лапы.<br><br>Управление: <b>WASD</b> или <b>Стрелки</b> для движения.<br>Мышь — направление фонарика.</p>
        <button class="btn" onclick="startGame()">Войти в тьму</button>
    </div>

    <div id="jumpscare">
        <div id="jumpscare-face">💋🩸</div>
    </div>

    <canvas id="gameCanvas"></canvas>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        let width, height;

        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        // --- ЗВУКОВОЙ ДВИЖОК ---
        let audioCtx;
        let heartbeatInterval;

        function initAudio() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }

        function playSound(type) {
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain); gain.connect(audioCtx.destination);
            const now = audioCtx.currentTime;

            if (type === 'step') {
                osc.type = 'triangle'; osc.frequency.setValueAtTime(100, now);
                gain.gain.setValueAtTime(0.1, now); gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
                osc.start(now); osc.stop(now + 0.1);
            } else if (type === 'pickup') {
                osc.type = 'sine'; osc.frequency.setValueAtTime(400, now); osc.frequency.exponentialRampToValueAtTime(800, now + 0.2);
                gain.gain.setValueAtTime(0.2, now); gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                osc.start(now); osc.stop(now + 0.3);
            } else if (type === 'heartbeat') {
                osc.type = 'sine'; osc.frequency.setValueAtTime(60, now);
                gain.gain.setValueAtTime(0.5, now); gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
                osc.start(now); osc.stop(now + 0.2);
            } else if (type === 'scream') {
                osc.type = 'sawtooth'; osc.frequency.setValueAtTime(800, now); osc.frequency.exponentialRampToValueAtTime(100, now + 1);
                gain.gain.setValueAtTime(1, now); gain.gain.linearRampToValueAtTime(0, now + 1);
                osc.start(now); osc.stop(now + 1);
            }
        }

        // --- ИГРОВАЯ ЛОГИКА ---
        let isPlaying = false;
        let mouseX = width / 2;
        let mouseY = height / 2;
        const keys = { w: false, a: false, s: false, d: false, ArrowUp: false, ArrowLeft: false, ArrowDown: false, ArrowRight: false };

        let player = { x: 0, y: 0, radius: 15, speed: 3.5 };
        let monster = { x: 0, y: 0, radius: 20, speed: 1.2 }; // Чуть медленнее, чтобы можно было убежать
        let items = [];
        let score = 0;
        let walls = [];
        
        // Рисуем "пол" (сетка, чтобы видеть движение)
        function drawFloor() {
            ctx.strokeStyle = '#1a0505';
            ctx.lineWidth = 1;
            const gridSize = 50;
            for(let x = 0; x < width; x += gridSize) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
            }
            for(let y = 0; y < height; y += gridSize) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
            }
        }

        window.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
        });

        window.addEventListener('keydown', (e) => { if (keys.hasOwnProperty(e.key)) keys[e.key] = true; });
        window.addEventListener('keyup', (e) => { if (keys.hasOwnProperty(e.key)) keys[e.key] = false; });

        function startGame() {
            initAudio();
            document.getElementById('start-screen').style.display = 'none';
            isPlaying = true;
            
            player.x = width / 2;
            player.y = height / 2;
            score = 0;
            document.getElementById('score').textContent = score;
            
            // Монстр далеко
            monster.x = Math.random() > 0.5 ? 50 : width - 50;
            monster.y = Math.random() > 0.5 ? 50 : height - 50;

            // Артефакты
            items = [];
            for (let i = 0; i < 3; i++) {
                items.push({
                    x: Math.random() * (width - 200) + 100,
                    y: Math.random() * (height - 200) + 100,
                    radius: 12,
                    collected: false
                });
            }

            // Стены
            walls = [];
            for (let i = 0; i < 20; i++) {
                walls.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    w: Math.random() * 150 + 50,
                    h: Math.random() * 30 + 20
                });
            }

            clearInterval(heartbeatInterval);
            heartbeatInterval = setInterval(() => {
                if(!isPlaying) return;
                const dist = Math.hypot(player.x - monster.x, player.y - monster.y);
                if (dist < 400) playSound('heartbeat');
            }, 1000);

            gameLoop();
        }

        function endGame() {
            isPlaying = false;
            clearInterval(heartbeatInterval);
            playSound('scream');
            
            document.getElementById('jumpscare').style.display = 'flex';
            
            setTimeout(() => {
                document.getElementById('jumpscare').style.display = 'none';
                document.getElementById('start-screen').style.display = 'flex';
                document.querySelector('#start-screen h1').textContent = "Она забрала тебя...";
                document.querySelector('.btn').textContent = "Попробовать снова";
            }, 2000);
        }

        function update() {
            if (!isPlaying) return;

            // Движение
            let dx = 0, dy = 0;
            if (keys.w || keys.ArrowUp) dy -= 1;
            if (keys.s || keys.ArrowDown) dy += 1;
            if (keys.a || keys.ArrowLeft) dx -= 1;
            if (keys.d || keys.ArrowRight) dx += 1;

            if (dx !== 0 || dy !== 0) {
                const len = Math.hypot(dx, dy);
                player.x += (dx / len) * player.speed;
                player.y += (dy / len) * player.speed;
                if (Math.random() < 0.1) playSound('step');
            }

            player.x = Math.max(player.radius, Math.min(width - player.radius, player.x));
            player.y = Math.max(player.radius, Math.min(height - player.radius, player.y));

            // Монстр преследует
            const angle = Math.atan2(player.y - monster.y, player.x - monster.x);
            monster.x += Math.cos(angle) * monster.speed;
            monster.y += Math.sin(angle) * monster.speed;

            if (Math.hypot(player.x - monster.x, player.y - monster.y) < player.radius + monster.radius) {
                endGame();
            }

            // Сбор
            items.forEach((item) => {
                if (!item.collected) {
                    if (Math.hypot(player.x - item.x, player.y - item.y) < player.radius + item.radius) {
                        item.collected = true;
                        score++;
                        document.getElementById('score').textContent = score;
                        playSound('pickup');
                        if (score >= 3) {
                            isPlaying = false;
                            clearInterval(heartbeatInterval);
                            document.getElementById('start-screen').style.display = 'flex';
                            document.querySelector('#start-screen h1').textContent = "Ты сбежал!";
                            document.querySelector('#start-screen p').textContent = "Но она все еще где-то рядом...";
                            document.querySelector('.btn').textContent = "Играть снова";
                        }
                    }
                }
            });

            // Паника
            const distToMonster = Math.hypot(player.x - monster.x, player.y - monster.y);
            if (distToMonster < 300) {
                const intensity = (300 - distToMonster) / 300;
                document.getElementById('blood-overlay').style.boxShadow = `inset 0 0 150px ${intensity * 100}px rgba(255, 0, 0, ${intensity * 0.8})`;
                monster.speed = 1.2 + (intensity * 1.5); // Ускоряется
            } else {
                document.getElementById('blood-overlay').style.boxShadow = `inset 0 0 100px 50px rgba(255, 0, 0, 0)`;
                monster.speed = 1.2;
            }
        }

        function draw() {
            if (!isPlaying && document.getElementById('jumpscare').style.display !== 'flex') return;

            // 1. Очистка фона
            ctx.fillStyle = '#050505';
            ctx.fillRect(0, 0, width, height);
            drawFloor(); // Рисуем сетку на полу

            // 2. Рисуем стены
            ctx.fillStyle = '#2a0505'; // Более видимый красный
            ctx.strokeStyle = '#4a0000';
            ctx.lineWidth = 2;
            walls.forEach(w => {
                ctx.fillRect(w.x, w.y, w.w, w.h);
                ctx.strokeRect(w.x, w.y, w.w, w.h);
            });

            // 3. Рисуем артефакты (Светятся сильно)
            items.forEach(item => {
                if (!item.collected) {
                    ctx.fillStyle = '#ff0033';
                    ctx.shadowBlur = 30;
                    ctx.shadowColor = '#ff0033';
                    ctx.beginPath();
                    ctx.arc(item.x, item.y, item.radius, 0, Math.PI * 2);
                    ctx.fill();
                    
                    // Внутренний белый блик
                    ctx.fillStyle = '#fff';
                    ctx.beginPath();
                    ctx.arc(item.x, item.y, item.radius/3, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.shadowBlur = 0;
                }
            });

            // 4. Рисуем монстра
            ctx.fillStyle = '#ff0000';
            ctx.shadowBlur = 40;
            ctx.shadowColor = '#ff0000';
            ctx.font = '50px Arial';
            ctx.fillText('💋', monster.x - 25, monster.y + 15);
            ctx.shadowBlur = 0;

            // 5. Рисуем игрока (Белая точка)
            ctx.fillStyle = '#fff';
            ctx.shadowBlur = 20;
            ctx.shadowColor = '#fff';
            ctx.beginPath();
            ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;

            // --- МАСКА ТЕМНОТЫ (ТЕПЕРЬ ПРОЗРАЧНЕЕ) ---
            // Накладываем темный слой (не 100% черный, а 85%, чтобы контуры были видны)
            ctx.fillStyle = 'rgba(0, 0, 0, 0.85)';
            ctx.fillRect(0, 0, width, height);

            // ВЫРЕЗАЕМ СВЕТ
            ctx.globalCompositeOperation = 'destination-out';
            
            // 1. Круг вокруг игрока (обзор)
            let gradient = ctx.createRadialGradient(player.x, player.y, 10, player.x, player.y, 200);
            gradient.addColorStop(0, 'rgba(0,0,0,1)');
            gradient.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(player.x, player.y, 200, 0, Math.PI * 2);
            ctx.fill();

            // 2. Конус фонарика (Яркий и широкий)
            const flashAngle = Math.atan2(mouseY - player.y, mouseX - player.x);
            
            ctx.beginPath();
            ctx.moveTo(player.x, player.y);
            ctx.arc(player.x, player.y, 600, flashAngle - 0.5, flashAngle + 0.5); // Широкий угол
            ctx.closePath();
            
            gradient = ctx.createRadialGradient(player.x, player.y, 50, player.x, player.y, 600);
            gradient.addColorStop(0, 'rgba(0,0,0,1)');
            gradient.addColorStop(0.8, 'rgba(0,0,0,0.8)');
            gradient.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = gradient;
            ctx.fill();

            ctx.globalCompositeOperation = 'source-over';

            // Прицел
            ctx.strokeStyle = 'rgba(255, 0, 0, 0.8)';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(mouseX, mouseY, 8, 0, Math.PI * 2);
            ctx.stroke();
        }

        function gameLoop() {
            update();
            draw();
            if (isPlaying) {
                requestAnimationFrame(gameLoop);
            }
        }
    </script>
</body>
</html>
